{
  "name": "examguard",
  "private": true,
  "version": "1.0.0",
  "productName": "ExamGuard",
  "description": "Secure Examination Desktop Application",
  "main": "./electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "app": "npm run build && electron .",
    "build": "vite build",
    "build:mac": "npm run build && electron-builder --mac dmg --arm64",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.examguard.desktop",
    "productName": "ExamGuard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "extendInfo": {
        "NSCameraUsageDescription": "ExamGuard requires camera access for candidate proctoring during assessments.",
        "NSMicrophoneUsageDescription": "ExamGuard requires microphone access for candidate proctoring during assessments."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "ExamGuard Installer"
    }
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
